{
  "rules": {
    ".read": false,
    ".write": false,
    "signals": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[A-Za-z0-9_-]{43}$/)",
        "$id": {
          ".write": "auth != null && $room.matches(/^[A-Za-z0-9_-]{43}$/) && (!newData.exists() || !data.exists())",
          ".validate": "newData.hasChildren(['from', 'data', 'at'])",
          "from": {
            ".validate": "newData.isString() && (newData.val() === 'a' || newData.val() === 'b')"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16000"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rateLimits": {
      ".read": false,
      ".write": false
    },
    "inboxOwners": {
      "$inbox": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": false
      }
    },
    "requests": {
      "$inbox": {
        ".read": "auth != null && root.child('inboxOwners/' + $inbox + '/uid').val() === auth.uid",
        "$id": {
          ".write": "auth != null && root.child('inboxOwners/' + $inbox + '/uid').val() === auth.uid && !newData.exists()"
        }
      }
    }
  }
}
