{
  "expo": {
    "name": "Pear",
    "slug": "pear",
    "scheme": "pear",
    "version": "1.3.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.louca.pear",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "expo-secure-store",
      "react-native-libsodium",
      [
        "expo-camera",
        {
          "cameraPermission": "Pear utilise la caméra pour lire le QR code de vos contacts et prendre des photos et des vidéos.",
          "microphonePermission": "Pear utilise le micro pour enregistrer le son de vos vidéos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0",
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-video",
      "./plugins/with-release-signing",
      "./plugins/with-dark-launch",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-image-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Pear utilise le micro pour enregistrer vos messages vocaux.",
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
